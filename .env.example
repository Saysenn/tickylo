# =============================================================================
# SUPABASE — Supabase Dashboard → Project Settings → API
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# Supabase service role key — server-side only, never expose to the browser
# Supabase Dashboard → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# =============================================================================
# APP
# =============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Override the API base URL if hosting the API separately (leave unset for monorepo)
# NEXT_PUBLIC_API_URL=http://localhost:3000/api

# =============================================================================
# PRISMA — Supabase Dashboard → Project Settings → Database → Connection string
# Use "Transaction" mode URL for DATABASE_URL (port 6543)
# Use "Session" mode URL for DIRECT_URL  (port 5432)
# =============================================================================
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# =============================================================================
# EMAIL — Resend (https://resend.com)
# Used for password resets, invites, and notifications
# =============================================================================
RESEND_API_KEY=re_<your-resend-api-key>
EMAIL_FROM=Tickworks <noreply@yourdomain.com>

# =============================================================================
# CRON — Vercel Cron job authentication
# Set a random secret here and add it to vercel.json as the Authorization header
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# =============================================================================
CRON_SECRET=<random-secret>

# =============================================================================
# FILE STORAGE — Thread attachment encryption key
# Used to encrypt cloud storage credentials (Supabase/S3) stored in the database
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be exactly 64 hex characters (32 bytes)
# =============================================================================
STORAGE_ENCRYPTION_KEY=<64-char-hex-string>

# =============================================================================
# REDIS — Optional. Caches heavy API routes (reports, team summary).
# Without this, routes still work — just hit the DB on every request.
# Managed options: Upstash (upstash.com), Railway, Render — all have free tiers.
# Local dev:  brew install redis && redis-server
#             OR: docker run -p 6379:6379 redis
# Upstash uses rediss:// (TLS); local uses redis://
# =============================================================================
# REDIS_URL=redis://localhost:6379

# =============================================================================
# STRIPE — Subscription billing
# Dashboard: https://dashboard.stripe.com
# 1. Create products + prices → copy IDs below
# 2. Add webhook endpoint → https://yourdomain.com/api/webhooks/stripe
# 3. Select events: customer.subscription.updated, customer.subscription.deleted,
#                   invoice.payment_succeeded, invoice.payment_failed
# 4. Copy webhook signing secret → STRIPE_WEBHOOK_SECRET
# 5. Enable Customer Portal: Stripe Dashboard → Billing → Customer Portal
# =============================================================================
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Business Plan price IDs (create in Stripe Dashboard → Products)
STRIPE_BUSINESS_BASE_MONTHLY=price_...    # $20/mo base
STRIPE_BUSINESS_SEAT_MONTHLY=price_...   # $4.99/seat/mo
STRIPE_BUSINESS_BASE_ANNUAL=price_...    # $200/yr base
STRIPE_BUSINESS_SEAT_ANNUAL=price_...    # $49.90/yr per seat

# Enterprise Plan price IDs
STRIPE_ENTERPRISE_BASE_MONTHLY=price_... # $100/mo flat
STRIPE_ENTERPRISE_BASE_ANNUAL=price_...  # $1000/yr flat
