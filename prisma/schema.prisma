// Prisma schema — connects to Supabase PostgreSQL
// Run: npx prisma db push after setting DATABASE_URL in .env.local

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

// In Prisma v7, connection URLs are defined in prisma.config.ts (not here)
datasource db {
  provider = "postgresql"
}

// ─── Multi-tenancy ───────────────────────────────────────────────────────────

model Organization {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  logo_url      String?
  org_join_code String   @unique @default(cuid())
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  users         User[]
  join_requests UserJoinRequest[]

  @@map("organizations")
}

model OrganizationApplication {
  id           String    @id @default(cuid())
  company_name String
  admin_name   String
  admin_email  String    @unique
  reason       String?
  status       String    @default("pending") // pending | approved | rejected
  reject_reason String?
  reviewed_at  DateTime?
  created_at   DateTime  @default(now())

  @@index([status])
  @@map("organization_applications")
}

model UserJoinRequest {
  id         String   @id @default(cuid())
  org_id     String
  user_id    String
  status     String   @default("pending") // pending | approved | rejected
  created_at DateTime @default(now())

  org  Organization @relation(fields: [org_id], references: [id], onDelete: Cascade)
  user User         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([org_id, user_id])
  @@index([org_id, status])
  @@map("user_join_requests")
}

// ─────────────────────────────────────────────────────────────────────────────

enum TaskStatus {
  needs_approval
  pending
  assigned
  in_progress
  on_hold
  stale
  completed
  closed
  rejected
}

enum TaskPriority {
  low
  medium
  high
  critical
}

// TicketType enum removed — ticket types are now dynamic via TicketTypeConfig

enum LeaveType {
  sick
  vacation
  emergency
}

enum LeaveStatus {
  pending
  approved
  rejected
  cancelled
}

// Extends Supabase auth.users with app-level data.
// id = auth.users.id (UUID). Row is created after a user signs up.
model User {
  id            String  @id
  org_id        String?
  department_id String?
  email         String  @unique
  name          String?
  avatar_url    String?
  role          String?

  TimeEntries       TimeEntry[]
  createdTasks      Task[]            @relation("TaskCreatedBy")
  assignedTasks     Task[]            @relation("TaskAssignedTo")
  taskComments      TaskComment[]
  notifications     Notification[]
  meta              UserMetaData?
  leave             Leave[]
  taskWatchers      TaskWatcher[]
  commentReactions  CommentReaction[]
  joinRequests      UserJoinRequest[]

  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt
  org        Organization? @relation(fields: [org_id], references: [id], onDelete: SetNull)
  department Department?  @relation(fields: [department_id], references: [id])

  @@index([org_id])
  @@index([department_id])
  @@map("users")
}

model Department {
  id     String  @id @default(cuid())
  org_id String?
  name   String

  users User[]

  @@unique([org_id, name])
  @@index([org_id])
  @@map("departments")
}

model TimeEntry {
  id          String    @id @default(cuid())
  org_id      String?
  user_id     String
  ticket_id   String?
  start_time  DateTime
  end_time    DateTime?
  title       String?
  description String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user   User  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  ticket Task? @relation("TicketTimeEntries", fields: [ticket_id], references: [id], onDelete: SetNull)

  @@index([org_id])
  @@index([user_id])
  @@index([ticket_id])
  @@index([start_time])
  @@map("time_entries")
}

model UserMetaData {
  id              String    @id @default(cuid())
  user_id         String    @unique
  dob             DateTime?
  phone           String?
  address         String?
  visa_status     String?
  visa_expiry     DateTime?
  passport_number String?
  date_joined     DateTime?
  salary          Float?

  sick_leave      Int? @default(0)
  vacation_leave  Int? @default(0)
  emergency_leave Int? @default(0)
  personal_leave  Int? @default(0)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_metadata")
}

model Task {
  id           String        @id @default(cuid())
  org_id       String?
  created_by   String
  user_id      String?       // assignee; null = unassigned pool
  title        String
  description  String?
  status       TaskStatus
  priority     TaskPriority?
  due_date     DateTime?
  completed_at DateTime?
  started_at   DateTime?
  assigned_at  DateTime?

  // Ticket fields — type is a free string keyed to TicketTypeConfig.key
  ticket_type         String  @default("internal_task")
  client_name         String?
  client_email        String?
  estimated_hours     Float?
  billable_hours      Float?
  implementation_plan String?
  rollback_plan       String?
  related_to          String?
  links               Json    @default("[]")
  source              String? // "sms" | "email" | "in_system"
  assignee_permission String  @default("editor") // "viewer" | "editor"

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  creator       User          @relation("TaskCreatedBy",  fields: [created_by], references: [id])
  assignee      User?         @relation("TaskAssignedTo", fields: [user_id],    references: [id])
  comments      TaskComment[]
  watchers      TaskWatcher[]
  subtasks      TaskSubtask[]
  relatedTicket Task?         @relation("RelatedTickets", fields: [related_to], references: [id], onDelete: SetNull)
  relatedFrom   Task[]        @relation("RelatedTickets")
  timeEntries   TimeEntry[]   @relation("TicketTimeEntries")

  @@index([org_id])
  @@index([created_by])
  @@index([user_id])
  @@index([status])
  @@index([due_date])
  @@index([ticket_type])
  @@map("tasks")
}

model TaskComment {
  id        String  @id @default(cuid())
  task_id   String
  user_id   String?  // null for system-generated comments
  body      String
  is_system Boolean  @default(false)

  created_at DateTime @default(now())

  task      Task              @relation(fields: [task_id], references: [id], onDelete: Cascade)
  author    User?             @relation(fields: [user_id], references: [id], onDelete: SetNull)
  reactions CommentReaction[]

  @@index([task_id])
  @@index([user_id])
  @@map("task_comments")
}

model TaskWatcher {
  id         String   @id @default(cuid())
  task_id    String
  user_id    String
  created_at DateTime @default(now())

  task Task @relation(fields: [task_id], references: [id], onDelete: Cascade)
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([task_id, user_id])
  @@index([task_id])
  @@map("task_watchers")
}

model CommentReaction {
  id         String   @id @default(cuid())
  comment_id String
  user_id    String
  emoji      String

  created_at DateTime @default(now())

  comment TaskComment @relation(fields: [comment_id], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [user_id],    references: [id], onDelete: Cascade)

  @@unique([comment_id, user_id, emoji])
  @@index([comment_id])
  @@map("comment_reactions")
}

model TaskSubtask {
  id        String  @id @default(cuid())
  task_id   String
  title     String
  completed Boolean @default(false)
  position  Int     @default(0)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  task Task @relation(fields: [task_id], references: [id], onDelete: Cascade)

  @@index([task_id])
  @@map("task_subtasks")
}

model Leave {
  id      String      @id @default(cuid())
  org_id  String?
  user_id String
  start   DateTime
  end     DateTime
  type    LeaveType
  status  LeaveStatus @default(pending)
  reason  String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([org_id])
  @@index([user_id])
  @@index([status])
  @@index([start])
}

model Notification {
  id         String   @id @default(cuid())
  org_id     String?
  user_id    String
  type       String   // task_assigned | task_reassigned | task_claimed | task_completed | transfer_requested | comment_added
  title      String
  body       String
  link       String?  // e.g. /dashboard/tasks/[id]
  read       Boolean  @default(false)

  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, read])
  @@index([created_at])
  @@map("notifications")
}

model TicketTypeConfig {
  id         String   @id @default(cuid())
  org_id     String?
  key        String            // stored in Task.ticket_type; e.g. "internal_task", "change"
  name       String            // "Internal Task", "Request for Change"
  prefix     String            // "TASK", "RFC"
  color      String   @default("gray") // "gray" | "blue" | "red" | "orange" | "purple" | "green" | "yellow"
  active     Boolean  @default(true)
  position   Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([org_id, key])
  @@index([org_id, active])
  @@map("ticket_type_configs")
}
