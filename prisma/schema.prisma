// Prisma schema — connects to Supabase PostgreSQL
// Run: npx prisma db push after setting DATABASE_URL in .env.local

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

// In Prisma v7, connection URLs are defined in prisma.config.ts (not here)
datasource db {
  provider = "postgresql"
}

enum TaskStatus {
  pending
  assigned
  in_progress
  completed
}

enum TaskPriority {
  low
  medium
  high
}

enum LeaveType {
  sick
  vacation
  emergency
}

enum LeaveStatus {
  pending
  approved
  rejected
}

// Extends Supabase auth.users with app-level data.
// id = auth.users.id (UUID). Row is created after a user signs up.
model User {
  id            String  @id
  department_id String?
  email         String  @unique
  name          String?
  avatar_url    String?
  role          String?

  TimeEntries TimeEntry[]
  Tasks       Task[]
  meta        UserMetaData?
  leave       Leave[]

  created_at DateTime    @default(now())
  updated_at DateTime    @updatedAt
  department Department? @relation(fields: [department_id], references: [id])

  @@index([department_id])
  @@map("users")
}

model Department {
  id    String @id @default(cuid())
  name  String @unique
  users User[]

  @@index([id])
}

model TimeEntry {
  id          String    @id @default(cuid())
  user_id     String
  start_time  DateTime
  end_time    DateTime?
  title       String?
  description String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@index([start_time])
  @@map("time_entries")
}

model UserMetaData {
  id              String    @id @default(cuid())
  user_id         String    @unique
  dob             DateTime?
  phone           String?
  address         String?
  visa_status     String?
  visa_expiry     DateTime?
  passport_number String?
  date_joined     DateTime?
  salary          Float?

  sick_leave      Int? @default(0)
  vacation_leave  Int? @default(0)
  emergency_leave Int? @default(0)
  personal_leave  Int? @default(0)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id])

  @@map("user_metadata")
}

model Task {
  id           String        @id @default(cuid())
  user_id      String
  title        String
  description  String?
  status       TaskStatus
  priority     TaskPriority?
  due_date     DateTime?
  completed_at DateTime?
  started_at   DateTime?
  assigned_at  DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@index([status])
  @@index([due_date])
  @@map("tasks")
}

model Leave {
  id      String      @id @default(cuid())
  user_id String
  start   DateTime
  end     DateTime
  type    LeaveType
  status  LeaveStatus @default(pending)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@index([status])
  @@index([start])
}
